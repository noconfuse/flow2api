{
  "manifest_version": 3,
  "name": "Flow2API Captcha Worker",
  "version": "1.1.5",
  "description": "Generate Google Labs reCAPTCHA Enterprise tokens for Flow2API.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://labs.google/*",
    "https://www.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/*"
      ],
      "js": [
        "content.js",
        "capture-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
